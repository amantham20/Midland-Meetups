rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Admin access:
    // 1) custom claim admin == true (preferred long-term), OR
    // 2) hard-coded bootstrap UIDs (first organizers — keep in sync with NEXT_PUBLIC_ADMIN_UIDS)
    function isBootstrapAdmin() {
      return signedIn() && request.auth.uid in [
        'HrTrYtRdntX7pesO72lRAVnPTZC2'
      ];
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        isBootstrapAdmin()
      );
    }

    match /events/{eventId} {
      // The account that submitted the event.
      function isEventOwner() {
        return signedIn() && resource.data.createdBy == request.auth.uid;
      }

      // The account tagged as host, if the submitter picked a member instead
      // of typing a name. `get` with a default so older docs without the field
      // don't error the whole rule.
      function isTaggedHost() {
        return signedIn()
          && resource.data.get('hostUserId', '') == request.auth.uid;
      }

      // Fields a host may change on their own event. `approved`, `createdBy`
      // and `createdAt` are deliberately absent: a host can't self-approve an
      // event or take one over from the account that submitted it.
      function hostEditableKeysOnly() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'host', 'hostUserId', 'date', 'time', 'location',
          'description', 'status', 'statusNote', 'tags', 'reminderSent',
          'updatedAt'
        ]);
      }

      allow read: if resource.data.approved == true || isAdmin()
        || (signedIn() && resource.data.createdBy == request.auth.uid)
        || isTaggedHost();
      allow create: if signedIn()
        && request.resource.data.approved == false
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasAll([
          'title', 'host', 'date', 'time', 'location', 'description',
          'status', 'statusNote', 'approved', 'createdBy'
        ]);
      allow update: if isAdmin()
        || ((isEventOwner() || isTaggedHost()) && hostEditableKeysOnly());
      // A submitter may withdraw an event that hasn't been approved yet — nobody
      // else can see it, and account deletion has to be able to clear it. An
      // approved event is on the board and stays admin-only to delete; the
      // deletion flow anonymizes the host name through `allow update` instead.
      allow delete: if isAdmin()
        || (isEventOwner() && resource.data.approved == false);
    }

    match /memories/{memoryId} {
      function isMemoryAuthor() {
        return signedIn() && resource.data.get('createdBy', '') == request.auth.uid;
      }

      allow read: if resource.data.approved == true || isAdmin()
        || (signedIn() && resource.data.createdBy == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.approved == false
        && request.resource.data.createdBy == request.auth.uid;
      // Authors get exactly one editable field, the byline, so account deletion
      // can strip their name off a story that's already published. `approved`
      // and `text` stay out of reach.
      allow update: if isAdmin()
        || (isMemoryAuthor()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['author']));
      allow delete: if isAdmin()
        || (isMemoryAuthor() && resource.data.approved == false);
    }

    match /squad/{memberId} {
      // Ownership is email-based (sign-in email == profile.email).
      function squadEmailMatches() {
        return signedIn()
          && request.auth.token.email is string
          && resource.data.email is string
          && resource.data.email == request.auth.token.email.lower();
      }

      function requestEmailMatchesAuth() {
        return signedIn()
          && request.auth.token.email is string
          && request.resource.data.email is string
          && request.resource.data.email == request.auth.token.email.lower();
      }

      allow read: if resource.data.approved == true || isAdmin()
        || squadEmailMatches()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || (signedIn() && resource.data.createdBy == request.auth.uid);

      // Photos are compressed base64 on the document (no Cloud Storage).
      // New profiles must use the sign-in email + stamp userId.
      allow create: if signedIn()
        && request.resource.data.approved == false
        && requestEmailMatchesAuth()
        && request.resource.data.userId == request.auth.uid
        && (!('photoBase64' in request.resource.data)
            || request.resource.data.photoBase64.size() < 350000);

      // Admins: full edit.
      // Email match: edit own profile; stamp userId to self; cannot change approval.
      allow update: if isAdmin()
        || (squadEmailMatches()
          && requestEmailMatchesAuth()
          && request.resource.data.approved == resource.data.approved
          && request.resource.data.userId == request.auth.uid
          && (!('photoBase64' in request.resource.data)
              || request.resource.data.photoBase64.size() < 350000));

      // Your profile is yours to remove — it carries your name, email, photo and
      // bio, so account deletion deletes it outright.
      allow delete: if isAdmin()
        || squadEmailMatches()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    // ——— The member boards ———
    //
    // Ideas and group goals are signed-in only, both to read and to write.
    // Nothing on them is public, so they skip the approval queue that gates the
    // public collections: what keeps them clean is that every row carries an
    // account, authors can edit and delete their own, admins can delete
    // anything, and both boards are reportable.

    match /ideas/{ideaId} {
      function isIdeaAuthor() {
        return signedIn() && resource.data.createdBy == request.auth.uid;
      }

      // What the author may change. `createdBy` and `createdAt` are absent, so
      // an idea can't be handed to another account.
      function authorEditableKeysOnly() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'pitch', 'timeframe', 'status', 'eventId', 'updatedAt'
        ]);
      }

      // Anybody may put a date on an open idea — that files an event submission
      // of their own and marks the idea scheduled. It's the one transition a
      // non-author gets, and it can't touch the pitch or unpark anything.
      function schedulingOnly() {
        return signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'eventId', 'updatedAt'
          ])
          && resource.data.status == 'open'
          && request.resource.data.status == 'planned';
      }

      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.eventId == ''
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 140
        && request.resource.data.pitch is string
        && request.resource.data.pitch.size() <= 2000;
      allow update: if isAdmin()
        || (isIdeaAuthor() && authorEditableKeysOnly())
        || schedulingOnly();
      allow delete: if isAdmin() || isIdeaAuthor();
    }

    // "I'd go" — one per member per idea, id-pinned like an RSVP.
    match /ideaVotes/{voteId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && voteId == request.auth.uid + '_' + request.resource.data.ideaId;
      // Your own vote, an organizer's call, or the author clearing the board
      // when they delete the idea itself.
      allow delete: if signedIn()
        && (resource.data.userId == request.auth.uid
          || isAdmin()
          || get(/databases/$(database)/documents/ideas/$(resource.data.ideaId))
              .data.createdBy == request.auth.uid);
    }

    match /goals/{goalId} {
      function isGoalOwner() {
        return signedIn() && resource.data.createdBy == request.auth.uid;
      }

      function ownerEditableKeysOnly() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'description', 'unit', 'target', 'deadline', 'status',
          'updatedAt'
        ]);
      }

      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 140
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.target is number
        && request.resource.data.target > 0;
      allow update: if isAdmin() || (isGoalOwner() && ownerEditableKeysOnly());
      allow delete: if isAdmin() || isGoalOwner();
    }

    // Contributions toward a goal. Everyone's add up to the total, so a member
    // may only ever write their own — and take their own back.
    match /goalLogs/{logId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.goalId is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 280;
      // Entries aren't edited — a wrong one is removed and logged again.
      allow update: if false;
      allow delete: if signedIn()
        && (resource.data.userId == request.auth.uid
          || isAdmin()
          || get(/databases/$(database)/documents/goals/$(resource.data.goalId))
              .data.createdBy == request.auth.uid);
    }

    match /rsvps/{rsvpId} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && rsvpId == request.auth.uid + '_' + request.resource.data.eventId
        && request.resource.data.status in ['going', 'not-going'];
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /fcmTokens/{tokenId} {
      allow read: if isAdmin();
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // Audience groups (tags): emails → who can see tagged events.
    // Signed-in users read so the client can filter; only admins write.
    match /groups/{groupId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Reports of objectionable content or accounts, filed from the app.
    //
    // Write-only for members: a report carries the name of whoever filed it, so
    // the queue is organizers-only — a reporter can't read back even their own.
    // `status` is pinned to 'open' on create so nobody files a pre-resolved
    // report, and only an organizer can move it or clear it out.
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.targetType in [
          'event', 'memory', 'member', 'idea', 'goal', 'other'
        ]
        && request.resource.data.targetId is string
        && request.resource.data.targetLabel is string
        && request.resource.data.reason is string
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 2000;
      allow update, delete: if isAdmin();
    }
  }
}
