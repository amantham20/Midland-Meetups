rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Admin access:
    // 1) custom claim admin == true (preferred long-term), OR
    // 2) hard-coded bootstrap UIDs (first organizers — keep in sync with NEXT_PUBLIC_ADMIN_UIDS)
    function isBootstrapAdmin() {
      return signedIn() && request.auth.uid in [
        'HrTrYtRdntX7pesO72lRAVnPTZC2'
      ];
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        isBootstrapAdmin()
      );
    }

    match /events/{eventId} {
      // The account that submitted the event.
      function isEventOwner() {
        return signedIn() && resource.data.createdBy == request.auth.uid;
      }

      // The account tagged as host, if the submitter picked a member instead
      // of typing a name. `get` with a default so older docs without the field
      // don't error the whole rule.
      function isTaggedHost() {
        return signedIn()
          && resource.data.get('hostUserId', '') == request.auth.uid;
      }

      // Fields a host may change on their own event. `approved`, `createdBy`
      // and `createdAt` are deliberately absent: a host can't self-approve an
      // event or take one over from the account that submitted it.
      function hostEditableKeysOnly() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'host', 'hostUserId', 'date', 'time', 'location',
          'description', 'status', 'statusNote', 'tags', 'reminderSent',
          'updatedAt'
        ]);
      }

      allow read: if resource.data.approved == true || isAdmin()
        || (signedIn() && resource.data.createdBy == request.auth.uid)
        || isTaggedHost();
      allow create: if signedIn()
        && request.resource.data.approved == false
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasAll([
          'title', 'host', 'date', 'time', 'location', 'description',
          'status', 'statusNote', 'approved', 'createdBy'
        ]);
      allow update: if isAdmin()
        || ((isEventOwner() || isTaggedHost()) && hostEditableKeysOnly());
      // A submitter may withdraw an event that hasn't been approved yet — nobody
      // else can see it, and account deletion has to be able to clear it. An
      // approved event is on the board and stays admin-only to delete; the
      // deletion flow anonymizes the host name through `allow update` instead.
      allow delete: if isAdmin()
        || (isEventOwner() && resource.data.approved == false);
    }

    match /memories/{memoryId} {
      function isMemoryAuthor() {
        return signedIn() && resource.data.get('createdBy', '') == request.auth.uid;
      }

      allow read: if resource.data.approved == true || isAdmin()
        || (signedIn() && resource.data.createdBy == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.approved == false
        && request.resource.data.createdBy == request.auth.uid;
      // Authors get exactly one editable field, the byline, so account deletion
      // can strip their name off a story that's already published. `approved`
      // and `text` stay out of reach.
      allow update: if isAdmin()
        || (isMemoryAuthor()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['author']));
      allow delete: if isAdmin()
        || (isMemoryAuthor() && resource.data.approved == false);
    }

    match /squad/{memberId} {
      // Ownership is email-based (sign-in email == profile.email).
      function squadEmailMatches() {
        return signedIn()
          && request.auth.token.email is string
          && resource.data.email is string
          && resource.data.email == request.auth.token.email.lower();
      }

      function requestEmailMatchesAuth() {
        return signedIn()
          && request.auth.token.email is string
          && request.resource.data.email is string
          && request.resource.data.email == request.auth.token.email.lower();
      }

      allow read: if resource.data.approved == true || isAdmin()
        || squadEmailMatches()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || (signedIn() && resource.data.createdBy == request.auth.uid);

      // Photos are compressed base64 on the document (no Cloud Storage).
      // New profiles must use the sign-in email + stamp userId.
      allow create: if signedIn()
        && request.resource.data.approved == false
        && requestEmailMatchesAuth()
        && request.resource.data.userId == request.auth.uid
        && (!('photoBase64' in request.resource.data)
            || request.resource.data.photoBase64.size() < 350000);

      // Admins: full edit.
      // Email match: edit own profile; stamp userId to self; cannot change approval.
      allow update: if isAdmin()
        || (squadEmailMatches()
          && requestEmailMatchesAuth()
          && request.resource.data.approved == resource.data.approved
          && request.resource.data.userId == request.auth.uid
          && (!('photoBase64' in request.resource.data)
              || request.resource.data.photoBase64.size() < 350000));

      // Your profile is yours to remove — it carries your name, email, photo and
      // bio, so account deletion deletes it outright.
      allow delete: if isAdmin()
        || squadEmailMatches()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /rsvps/{rsvpId} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && rsvpId == request.auth.uid + '_' + request.resource.data.eventId
        && request.resource.data.status in ['going', 'not-going'];
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /fcmTokens/{tokenId} {
      allow read: if isAdmin();
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // Audience groups (tags): emails → who can see tagged events.
    // Signed-in users read so the client can filter; only admins write.
    match /groups/{groupId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
